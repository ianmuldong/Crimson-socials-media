node_modules
dist
.DS_Store
.env
out

# Remotion's downloaded browser
.remotion

# Large media: raw iPhone footage and regenerated proxies stay local by default.
# (Files uploaded through the GitHub website are still committed.)
public/footage/raw/*
!public/footage/raw/README.md
public/footage/processed/*
!public/footage/processed/.gitkeep

# Scratch renders made with plain `npx remotion render` (default folder)
out/

# The GitHub repository is PUBLIC: never commit anything that contains real
# footage (players' faces). Previews, storyboards, contact sheets, thumbnails and
# final renders stay local and are delivered directly (or via a private channel).
exports/analysis/
exports/previews/*.mp4
exports/previews/storyboards/
exports/final/
exports/reels/*.mp4

# Synthetic voice: model files are ~340 MB and downloaded on demand; work files are temporary.
exports/voice-models/
exports/voice-work/

# Generated narration tracks (re-create with: npm run voiceover)
public/audio/voiceover/
